@model IReadOnlyList<erpWeb.Core.Clients.ClientDto>
@{
    ViewData["Title"] = "Clients";
}

<en-tete-page titre="Clients" icone="bi-building">
    <a asp-action="Creer" class="btn btn-primary" asp-permission="@Permissions.Clients.Gerer">
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nouveau client
    </a>
</en-tete-page>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle w-100" data-tableau>
                <thead>
                    <tr>
                        <th scope="col">Raison sociale</th>
                        <th scope="col">Code postal</th>
                        <th scope="col">Ville</th>
                        <th scope="col">Pays</th>
                        <th scope="col">Téléphone</th>
                        <th scope="col">Email</th>
                        <th scope="col" class="text-end" data-orderable="false">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model)
                    {
                        <tr>
                            <td>@client.RaisonSociale</td>
                            <td>@client.CodePostal</td>
                            <td>@client.Ville</td>
                            <td>@client.Pays</td>
                            <td class="text-nowrap">@client.Telephone1</td>
                            <td class="text-break">
                                @if (!string.IsNullOrEmpty(client.Email))
                                {
                                    <a href="mailto:@client.Email">@client.Email</a>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <div class="d-inline-flex gap-1" asp-permission="@Permissions.Clients.Gerer">
                                    <a asp-action="Modifier" asp-route-id="@client.Id" class="btn btn-sm btn-outline-secondary" title="Modifier" aria-label="Modifier @client.RaisonSociale">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                    <form asp-action="Supprimer" asp-route-id="@client.Id" method="post" data-confirmation="Supprimer définitivement le client @client.RaisonSociale ?">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer" aria-label="Supprimer @client.RaisonSociale"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
